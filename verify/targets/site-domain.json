{
  "name": "site-domain",
  "url": "https://www.nate-victor.com",
  "expect": [
    "header.bar[data-bar]",
    "h1#hero-title[data-hero]",
    "a.h-link[href='#sidequests']",
    "time.clock[data-clock]",
    "section#now a.now-card[href='https://www.medstrata.ai']",
    "ol.cards-feature li.qc.qc-feature",
    "ol.cards-grid li.qc",
    "ul.more li.mc",
    "ol.log[data-log] li.entry.is-now",
    "section#about .portrait img",
    "section#contact button[data-copy]",
    "footer.foot[data-footer]"
  ],
  "expectText": [
    "Nate Victor.",
    "MedStrata AI"
  ],
  "wowPath": [
    {
      "hover": "li.qc[data-quest='photoncar'] .qc-name",
      "wait": 1800,
      "expect": "li.qc[data-quest='photoncar'] .qc-media[data-playing='true']"
    },
    {
      "expect": "li.qc[data-quest='race-engineer'] a.demo[href='https://race-engineer-tau.vercel.app']"
    },
    {
      "click": "button[data-copy]",
      "expect": "button[data-copy][data-copied='true']"
    }
  ],
  "wowDesktopOnly": true,
  "checkLinks": true,
  "fullPageShot": true,
  "settleMs": 2500
}
